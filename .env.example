# ─── Database (MySQL) ────────────────────────────────────────────────────────
# Development: uses docker-compose MySQL on port 3307
DATABASE_URL="mysql://app_user:app_password_2024@localhost:3307/consultorio"

# Production (Vercel u otro serverless): apuntar a un MySQL accesible
# públicamente y con SSL (PlanetScale, Railway, Aiven, TiDB, etc.).
# DATABASE_URL="mysql://user:password@host:3306/consultorio?sslaccept=strict"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""

# URL canónica de la app (callbacks de Auth.js).
# Desarrollo:
AUTH_URL="http://localhost:3000"
# Producción: AUTH_URL="https://tu-dominio.com"
# (NEXTAUTH_URL sigue funcionando como alias por compatibilidad.)

# Recomendado en Vercel / detrás de proxy (Auth.js v5):
AUTH_TRUST_HOST="true"

# ─── Cifrado de datos clínicos (Ley 25.326 — datos sensibles) ────────────────
# Clave AES-256 en base64 (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# OBLIGATORIA en producción: sin ella, los datos clínicos se guardan SIN cifrar.
# ⚠️ Guardá un backup seguro de la clave: si se pierde, la HC es irrecuperable.
HC_ENC_KEY=""
# Rotación: agregá HC_ENC_KEY_2, HC_ENC_KEY_3... y HC_ENC_ACTIVE_KEY="2" para
# cifrar con la nueva; las anteriores siguen descifrando lo viejo.
# HC_ENC_ACTIVE_KEY="1"

# ─── Admin inicial (solo para el seed, opcional) ─────────────────────────────
# Únicamente las usa `pnpm run db:seed-base` para crear el admin.
# NO son necesarias en runtime ni en Vercel.
# ADMIN_EMAIL="admin@tu-dominio.com"
# ADMIN_PASSWORD="CambiarEsto123"
