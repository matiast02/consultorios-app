# ─── Database (MySQL) ────────────────────────────────────────────────────────
# Development: uses docker-compose MySQL on port 3307
DATABASE_URL="mysql://app_user:app_password_2024@localhost:3307/consultorio"

# Production (Vercel u otro serverless): apuntar a un MySQL accesible
# públicamente y con SSL (PlanetScale, Railway, Aiven, TiDB, etc.).
# DATABASE_URL="mysql://user:password@host:3306/consultorio?sslaccept=strict"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Secreto de firma de sesiones y tokens (mínimo 32 caracteres).
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la app (cookies Secure, chequeo de Origin, links).
# Desarrollo:
NEXTAUTH_URL="http://localhost:3000"
# Producción (OBLIGATORIO https; el servidor no arranca si no lo es):
# NEXTAUTH_URL="https://tu-dominio.com"
# (AUTH_URL y BETTER_AUTH_URL se aceptan como alias.)

# ─── Cifrado de datos clínicos (Ley 25.326 — datos sensibles) ────────────────
# Clave AES-256 en base64 (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# OBLIGATORIA en producción: sin ella, los datos clínicos se guardan SIN cifrar.
# ⚠️ Guardá un backup seguro de la clave: si se pierde, la HC es irrecuperable.
HC_ENC_KEY=""
# Rotación: agregá HC_ENC_KEY_2, HC_ENC_KEY_3... y HC_ENC_ACTIVE_KEY="2" para
# cifrar con la nueva; las anteriores siguen descifrando lo viejo.
# HC_ENC_ACTIVE_KEY="1"

# ─── Admin inicial (solo para el seed, opcional) ─────────────────────────────
# Únicamente las usa `pnpm run db:seed-base` para crear el admin.
# NO son necesarias en runtime ni en Vercel.
# ADMIN_EMAIL="admin@tu-dominio.com"
# ADMIN_PASSWORD="CambiarEsto123"

# ─── Email (recuperación de contraseña, recordatorios, copias de HC) ──────────
# Proveedor: "resend" | "smtp" | "console". Si falta, se infiere de las credenciales.
# Sin proveedor: en desarrollo los emails se imprimen en consola; en producción
# los envíos quedan FAILED (visibles en el dashboard de recepción).
# EMAIL_PROVIDER="resend"
EMAIL_FROM="Consultorio <no-reply@tu-dominio.com>"
# Resend (https://resend.com): solo la API key
# RESEND_API_KEY="re_…"
# SMTP (cualquier proveedor):
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT="587"
# SMTP_USER="usuario"
# SMTP_PASS="contraseña"
# SMTP_SECURE="false"

# ─── Cron de recordatorios ──────────────────────────────────────────────────
# POST /api/cron/reminders con header  Authorization: Bearer <CRON_SECRET>
# (desde el cron del host, Dokploy o un servicio externo, cada 15-30 min).
# Generar con: openssl rand -hex 32
CRON_SECRET=""
