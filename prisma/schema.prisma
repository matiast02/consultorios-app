generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth Models ──────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String    @default("")
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  firstName        String?
  lastName         String?
  licenseNumber    String? // Matricula profesional
  specializationId String?
  defaultRoom      String? // Consultorio asignado por defecto (ej: "C1", "Sala A")

  // Contact + professional bio
  phone         String?
  officeAddress String?
  bio           String? @db.Text // max 280 chars (validar en zod)

  // Scheduling config
  slotDurationMinutes Int @default(30)
  bufferMinutes       Int @default(0)
  minAdvanceMinutes   Int @default(60)

  // Regional prefs
  language  String @default("es-AR")
  timezone  String @default("America/Argentina/Buenos_Aires")
  weekStart Int    @default(1) // 0=Sunday, 1=Monday

  // Notification toggles
  notifyReminder24h   Boolean @default(true)
  notifyReminder2h    Boolean @default(true)
  notifyNewShift      Boolean @default(true)
  notifyCancellation  Boolean @default(true)
  notifyWeeklySummary Boolean @default(false)
  notifySmsFallback   Boolean @default(true)

  specialization     Specialization?    @relation(fields: [specializationId], references: [id])
  accounts           Account[]
  sessions           Session[]
  roles              UserRole[]
  shifts             Shift[]
  preferences        UserPreference[]
  blockDays          BlockDay[]
  evolutions         Evolution[]
  auditLogs          AuditLog[]
  prescriptions      Prescription[]
  studyOrders        StudyOrder[]
  mealPlans          MealPlan[]
  notifications      Notification[]
  moduleAccess       UserModuleAccess[]
  acceptedInsurances UserInsurance[]
  grantsReceived     ClinicalAccessGrant[] @relation("grantsReceived")

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([specializationId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String // Para providerId "credential": el id del usuario
  providerId            String // "credential" (email + password) o proveedor OAuth
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text // hash bcrypt (solo providerId = "credential")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// ─── Better Auth: rate limit persistente (storage: "database") ───────────────

model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique // ip o ip+ruta
  count       Int
  lastRequest BigInt // epoch ms
}

// ─── Profession Configs ──────────────────────────────────────────────────────

model ProfessionConfig {
  id                  String @id @default(cuid())
  code                String @unique // "medic", "psychologist", "dentist"
  name                String // "Médico", "Psicólogo", "Dentista"
  professionalLabel   String // "Dr/a.", "Lic.", "Od."
  patientLabel        String @default("Paciente")
  prescriptionLabel   String // "Receta", "Indicación", "Plan de tratamiento"
  evolutionLabel      String // "Evolución", "Nota de sesión", "Registro odontológico"
  clinicalRecordLabel String // "Historia Clínica", "Ficha Psicológica", "Ficha Dental"
  enabledModules      String @db.Text // JSON: ["prescriptions","study_orders"]
  clinicalFields      String @db.Text // JSON: campos del template de HC

  specializations Specialization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Specializations ─────────────────────────────────────────────────────────

model Specialization {
  id                 String  @id @default(cuid())
  name               String  @unique
  color              String? // Hex color for medic dot (e.g. "#0EA5E9")
  professionConfigId String?

  professionConfig ProfessionConfig? @relation(fields: [professionConfigId], references: [id])
  users            User[]
  contactRequests  ContactRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionConfigId])
}

// ─── Consultation Types ─────────────────────────────────────────────────────

model ConsultationType {
  id              String  @id @default(cuid())
  name            String  @unique // "Primera vez", "Control", "Urgencia"
  durationMinutes Int // 40, 20, 15
  color           String? // Color hex opcional
  isDefault       Boolean @default(false)

  shifts Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Roles ────────────────────────────────────────────────────────────────────

model Role {
  id   String @id @default(cuid())
  name String @unique // "medic", "secretary", "admin"

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ─── Patients ─────────────────────────────────────────────────────────────────

model Patient {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  birthDate DateTime?
  sex       String? // "M", "F", "X"
  dni       String?   @unique
  email     String?
  telephone String?
  address   String?
  country   String?
  province  String?
  osId      String?
  osNumber  String?

  // Emergency contact (Paciente redesign)
  emergencyContactName  String?
  emergencyContactPhone String?

  // Autoría: quién dio de alta y quién archivó (ids de User; null en datos migrados)
  createdById String?
  deletedById String?

  // Consentimiento informado para el tratamiento de datos de salud (Ley 25.326 art. 5-6)
  consentType    ConsentType?
  consentGivenAt DateTime?
  consentNote    String?      @db.Text // cómo se obtuvo / observaciones (cifrado)

  // Recordatorios: el paciente puede optar por no recibirlos (Ley 25.326 art. 27 / oposición)
  reminderOptOut   Boolean   @default(false)
  reminderOptOutAt DateTime?

  os             HealthInsurance?   @relation(fields: [osId], references: [id])
  shifts         Shift[]
  clinicalRecord ClinicalRecord?
  prescriptions  Prescription[]
  studyOrders    StudyOrder[]
  mealPlans      MealPlan[]
  insurances     PatientInsurance[]
  walkInArrivals WalkInArrival[]
  accessGrants   ClinicalAccessGrant[]
  hcCopyRequests HcCopyRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dni])
  @@index([osId])
  @@index([createdById])
}

// ─── Health Insurance (Obra Social) ───────────────────────────────────────────

model HealthInsurance {
  id   String  @id @default(cuid())
  name String
  code String?

  patients          Patient[]
  patientInsurances PatientInsurance[]
  userInsurances    UserInsurance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Paciente puede tener multiples obras sociales
model PatientInsurance {
  id                String  @id @default(cuid())
  patientId         String
  healthInsuranceId String
  affiliateNumber   String? // Numero de afiliado

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthInsurance HealthInsurance @relation(fields: [healthInsuranceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([patientId, healthInsuranceId])
  @@index([patientId])
  @@index([healthInsuranceId])
}

// Profesional acepta ciertas obras sociales
model UserInsurance {
  id                String @id @default(cuid())
  userId            String
  healthInsuranceId String
  copago            Int    @default(0) // pesos

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthInsurance HealthInsurance @relation(fields: [healthInsuranceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, healthInsuranceId])
  @@index([userId])
  @@index([healthInsuranceId])
}

// ─── Shifts (Turnos) ─────────────────────────────────────────────────────────

enum ShiftStatus {
  PENDING
  CONFIRMED
  ABSENT
  FINISHED
  CANCELLED
}

model Shift {
  id                 String      @id @default(cuid())
  userId             String
  patientId          String
  start              DateTime
  end                DateTime
  observations       String?     @db.Text
  status             ShiftStatus @default(PENDING)
  isOverbook         Boolean     @default(false) // Sobreturno
  consultationTypeId String?
  recurrenceGroupId  String? // Shared ID for recurring shift series
  rescheduledFrom    DateTime? // Original date before auto-reschedule
  rescheduledAt      DateTime? // When the auto-reschedule happened

  // Confirmación y origen del turno
  confirmedAt DateTime?
  confirmedVia String? // "PATIENT_LINK" | "STAFF" | "PHONE"
  source       String    @default("STAFF") // "STAFF" | "ONLINE" (reserva web)

  // Reception / waiting-room state
  arrivedAt             DateTime? // Paciente llegó al consultorio (en sala de espera)
  consultationStartedAt DateTime? // Pasó a consulta

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationType ConsultationType? @relation(fields: [consultationTypeId], references: [id], onDelete: SetNull)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evolution        Evolution?
  prescriptions    Prescription[]
  studyOrders      StudyOrder[]
  mealPlans        MealPlan[]
  reminders        ShiftReminder[]
  walkInArrivals   WalkInArrival[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([patientId])
  @@index([start])
  @@index([arrivedAt])
}

// ─── User Preferences ────────────────────────────────────────────────────────

model UserPreference {
  id         String  @id @default(cuid())
  userId     String
  day        Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  fromHourAM String?
  toHourAM   String?
  fromHourPM String?
  toHourPM   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
}

// ─── Blocked Days ─────────────────────────────────────────────────────────────

enum BlockDayCategory {
  VACATION
  HOLIDAY
  CONFERENCE
  OTHER
}

model BlockDay {
  id       String           @id @default(cuid())
  userId   String
  date     DateTime
  category BlockDayCategory @default(OTHER)
  note     String?          @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// ─── Password Reset Tokens ───────────────────────────────────────────────────

model ResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ─── Clinical History (Historia Clínica) ─────────────────────────────────────

model ClinicalRecord {
  id                String  @id @default(cuid())
  patientId         String  @unique
  bloodType         String? // A+, A-, B+, B-, AB+, AB-, O+, O-
  allergies         String? @db.Text
  personalHistory   String? @db.Text // antecedentes personales
  familyHistory     String? @db.Text // antecedentes familiares
  currentMedication String? @db.Text // medicación habitual
  notes             String? @db.Text
  customFields      String? @db.Text // JSON: campos custom por profesión

  // Anthropometry (Paciente redesign)
  heightCm Int?
  weightKg Decimal? @db.Decimal(5, 2)

  // Structured habits
  habitsTobacco  String? @db.Text
  habitsAlcohol  String? @db.Text
  habitsActivity String? @db.Text
  habitsDiet     String? @db.Text

  // Structured allergies (JSON: { nombre, severidad: alta|media|baja, nota? }[])
  structuredAllergies String? @db.Text

  // Profession-specific visual editors (JSON)
  odontogram String? @db.Text // JSON OdontogramData (odontología)
  genogram   String? @db.Text // JSON GenogramData (psicología)

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evolutions Evolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model Evolution {
  id               String  @id @default(cuid())
  clinicalRecordId String
  shiftId          String? @unique
  userId           String // medic who wrote it

  reason        String? @db.Text // motivo de consulta
  physicalExam  String? @db.Text // examen físico
  diagnosis     String? @db.Text // diagnóstico
  diagnosisCode String? // CIE-10 code
  treatment     String? @db.Text // plan/tratamiento
  indications   String? @db.Text // indicaciones
  notes         String? @db.Text

  // Inalterabilidad: se anula (no se borra); las correcciones generan versiones.
  annulledAt   DateTime?
  annulReason  String?   @db.Text
  annulledById String?

  clinicalRecord ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user           User           @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicalRecordId])
  @@index([userId])
  @@index([shiftId])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  userId     String? // null = actor desconocido (p.ej. login fallido con email inexistente)
  action     String // CREATE, UPDATE, DELETE, VIEW_SENSITIVE
  resource   String // patient, shift, evolution, clinical_record, etc.
  resourceId String
  details    String? @db.Text // JSON con cambios o contexto
  ipAddress  String?
  userAgent  String?  @db.Text

  // Tamper-evidence: hash encadenado por (resource, resourceId).
  hash     String? @db.Text
  prevHash String? @db.Text

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([action])
}

// ─── Clinical Ledger (inalterabilidad) ───────────────────────────────────────
// Registro inmutable de versiones de asientos clínicos. Nunca se hace UPDATE ni
// DELETE sobre esta tabla: cada create/corrección/anulación agrega una fila.
// El hash encadena versiones por entidad para detectar manipulación.
model ClinicalEntryVersion {
  id          String   @id @default(cuid())
  entityType  String // "evolution" | "clinical_record" | "prescription" | "study_order" | "meal_plan"
  entityId    String // id del registro origen
  patientId   String? // para consultas por paciente
  version     Int // 1, 2, 3...
  action      String // "created" | "corrected" | "annulled"
  data        String   @db.Text // snapshot JSON de los campos clínicos
  authorId    String // autor de esta versión
  reason      String?  @db.Text // motivo de corrección/anulación
  contentHash String // sha256 del snapshot canónico
  prevHash    String? // contentHash de la versión anterior de esta entidad
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@index([patientId])
}

// ─── Concesiones de acceso a la HC entre profesionales ───────────────────────
// Ley 26.529 art. 19 inc. d (otro médico con autorización del paciente) y
// Ley 25.326 art. 11 (cesión de datos sensibles con consentimiento).
// El acceso cruzado entre médicos es siempre explícito, consentido, acotado
// en alcance y tiempo, revocable y auditado. Extiende lib/clinical-access.ts.

enum GrantStatus {
  PENDING // solicitada por el médico que necesita acceso
  ACTIVE // aprobada con consentimiento del paciente registrado
  REJECTED
  REVOKED
  EXPIRED
}

enum GrantScope {
  FULL
  PARTIAL // secciones y/o asientos concretos (sections / entryIds)
}

enum ConsentType {
  WRITTEN // escrito firmado por el paciente (o representante)
  VERBAL_RECORDED // verbal, registrado por el profesional con fecha
  DIGITAL_SIGNATURE // firma digital
}

model ClinicalAccessGrant {
  id              String       @id @default(cuid())
  patientId       String
  grantedToUserId String // médico que recibe acceso
  requestedById   String // quien creó la solicitud (normalmente el mismo médico)
  decidedById     String? // médico tratante o admin que aprobó / rechazó
  status          GrantStatus  @default(PENDING)
  scope           GrantScope   @default(FULL)
  sections        String?      @db.Text // JSON string[]: antecedentes|alergias|medicacion|evoluciones|recetas|estudios|planes
  entryIds        String?      @db.Text // JSON string[]: ids de asientos concretos
  reason          String       @db.Text // motivo clínico de la solicitud (cifrado)
  consentType     ConsentType?
  consentEvidence String?      @db.Text // cómo y cuándo se obtuvo el consentimiento (cifrado)
  consentAt       DateTime?
  startsAt        DateTime?
  expiresAt       DateTime?
  decidedAt       DateTime?
  decisionNote    String?      @db.Text // motivo de rechazo u observación (cifrado)
  revokedAt       DateTime?
  revokedById     String?

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantedTo User    @relation("grantsReceived", fields: [grantedToUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([grantedToUserId, status])
  @@index([status, expiresAt])
}

// ─── Copia de la historia clínica para el paciente ───────────────────────────
// Ley 26.529 art. 14 (copia autenticada dentro de las 48 hs) y art. 19
// (quiénes pueden pedirla). El paciente no es usuario: el personal registra
// la solicitud y la entrega; el PDF lleva los hashes del ledger.

enum HcCopyRequesterType {
  PATIENT
  LEGAL_REPRESENTATIVE
  HEIR
  EXTERNAL_PROFESSIONAL // médico de otra institución con autorización del paciente
  JUDICIAL
}

enum HcCopyStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model HcCopyRequest {
  id                String              @id @default(cuid())
  patientId         String
  requesterType     HcCopyRequesterType
  requesterName     String
  requesterDni      String?
  authorizationNote String?             @db.Text // cómo se acreditó el vínculo / autorización (cifrado)
  reason            String?             @db.Text // (cifrado)
  status            HcCopyStatus        @default(PENDING)
  registeredById    String // usuario que registró la solicitud
  requestedAt       DateTime            @default(now())
  dueAt             DateTime // requestedAt + 48 h
  deliveredAt       DateTime?
  deliveredById     String?
  deliveryNote      String?             @db.Text // "entregada en mano", "enviada por email" (cifrado)
  documentHash      String? // sha256 del PDF entregado

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status, dueAt])
}

// ─── Module System ───────────────────────────────────────────────────────────

model ModuleConfig {
  id      String  @id @default(cuid())
  module  String  @unique // "prescriptions", "lab_orders", etc.
  name    String // Display name
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserModuleAccess {
  id      String  @id @default(cuid())
  userId  String
  module  String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

// ─── Prescriptions (Recetas) ─────────────────────────────────────────────────

model Prescription {
  id        String  @id @default(cuid())
  patientId String
  userId    String // médico que receta
  shiftId   String? // turno asociado
  items     String  @db.Text // JSON array of PrescriptionItem
  diagnosis String?
  notes     String? @db.Text

  // Days of validity from createdAt; UI computes vigente|vencida
  durationDays Int @default(90)

  // Inalterabilidad: se anula (no se borra).
  annulledAt   DateTime?
  annulReason  String?   @db.Text
  annulledById String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([userId])
  @@index([shiftId])
}

// ─── Meal Plans (Planes Alimentarios) ────────────────────────────────────────

model MealPlan {
  id             String  @id @default(cuid())
  userId         String // Nutricionista
  patientId      String
  shiftId        String?
  title          String // "Plan hipocalorico", "Plan normocalorico"
  targetCalories Int? // kcal/dia
  proteinPct     Int? // % proteinas
  carbsPct       Int? // % carbohidratos
  fatPct         Int? // % grasas
  hydration      String? // "2 litros de agua"
  meals          String  @db.Text // JSON: MealSection[]
  avoidFoods     String? @db.Text // Alimentos a evitar
  supplements    String? @db.Text // Suplementos
  notes          String? @db.Text // Observaciones generales

  // Inalterabilidad: se anula (no se borra).
  annulledAt   DateTime?
  annulReason  String?   @db.Text
  annulledById String?

  user    User    @relation(fields: [userId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([userId])
}

// ─── Medications (Vademécum) ─────────────────────────────────────────────────

model Medication {
  id           String  @id @default(cuid())
  name         String  @unique
  genericName  String?
  presentation String? // ej: "Comprimidos 500mg"
  category     String? // ej: "Analgésico", "Antibiótico"

  createdAt DateTime @default(now())
}

// ─── Study Orders (Ordenes de Estudios) ─────────────────────────────────────

enum StudyOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StudyOrder {
  id          String           @id @default(cuid())
  userId      String // Medico que ordena
  patientId   String
  shiftId     String? // Turno asociado
  items       String           @db.Text // JSON array of StudyOrderItem
  status      StudyOrderStatus @default(PENDING)
  resultNotes String?          @db.Text // Notas de resultados

  // Inalterabilidad: se anula (no se borra). Distinto del status clínico del estudio.
  annulledAt   DateTime?
  annulReason  String?   @db.Text
  annulledById String?

  user    User    @relation(fields: [userId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([userId])
  @@index([shiftId])
  @@index([status])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id         String  @id @default(cuid())
  userId     String // Destinatario
  type       String // "pending_studies", "inactive_patient", "rescheduled"
  title      String
  message    String  @db.Text
  resourceId String? // ID del recurso relacionado
  read       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Shift Reminders (Recordatorios) ─────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model ShiftReminder {
  id           String         @id @default(cuid())
  shiftId      String
  scheduledFor DateTime // Cuándo debe enviarse el recordatorio
  status       ReminderStatus @default(PENDING)
  channel      String         @default("EMAIL") // "EMAIL" | "WHATSAPP" | "SMS"
  offsetHours  Int            @default(24) // 24 = recordatorio del día anterior, 2 = del día
  manual       Boolean        @default(false) // WhatsApp click-to-chat: lo envía recepción y lo marca
  deliveredTo  String? // email o teléfono usado (para trazabilidad)
  tokenHash    String?        @unique // sha256 del token del link de confirmación
  tokenExpiresAt DateTime?
  response     String? // "CONFIRMED" | "CANCELLED" (respuesta del paciente vía link)
  respondedAt  DateTime?
  sentAt       DateTime?
  errorMessage String?        @db.Text

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftId, offsetHours])
  @@index([shiftId])
  @@index([status, scheduledFor])
  @@index([scheduledFor])
}

// ─── Walk-In Arrivals (Pacientes sin turno previo) ──────────────────────────

model WalkInArrival {
  id              String    @id @default(cuid())
  patientId       String? // Si está cargado en el sistema
  firstName       String
  lastName        String
  telephone       String?
  note            String?   @db.Text // Motivo de la consulta walk-in
  arrivedAt       DateTime  @default(now())
  leftAt          DateTime?
  assignedShiftId String? // Si se le asignó un turno en el momento

  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedShift Shift?   @relation(fields: [assignedShiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([assignedShiftId])
  @@index([arrivedAt])
}

// ─── Clinic public site (singleton + weekly hours + contact inbox) ──────────

model ClinicSettings {
  id                     String   @id @default("default")
  name                   String?
  tagline                String?
  contactEmail           String?
  whatsappPrimary        String?
  whatsappSecondary      String?
  phoneDisplay           String?
  prefillWhatsappMessage String?  @db.Text
  addressLine1           String?
  addressLine2           String?
  mapLat                 Decimal? @db.Decimal(9, 6)
  mapLng                 Decimal? @db.Decimal(9, 6)
  mapZoom                Int?     @default(16)
  showTeam               Boolean  @default(true)
  showHours              Boolean  @default(true)
  showMap                Boolean  @default(true)
  showContactForm        Boolean  @default(true)
  yearsOfService         Int?
  patientsServedDisplay  String?

  // Recordatorios de turnos
  remindersEnabled           Boolean @default(true)
  reminderHoursBefore        Int     @default(24) // primer recordatorio
  reminderSecondHoursBefore  Int? // segundo recordatorio (p.ej. 2), opcional
  reminderChannels           String  @default("[\"EMAIL\",\"WHATSAPP\"]") // JSON ReminderChannel[]
  reminderTemplate           String? @db.Text // plantilla con {paciente} {fecha} {hora} {profesional} {consultorio} {direccion} {link}

  updatedAt              DateTime @updatedAt
}

model ClinicHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique // 0=Lun..6=Dom (Monday-start)
  closed    Boolean  @default(false)
  amOpen    String? // "08:00"
  amClose   String?
  pmOpen    String?
  pmClose   String?
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id               String          @id @default(cuid())
  fullName         String
  phone            String
  email            String?
  healthInsurance  String?
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  preferredDay     String?
  message          String?         @db.Text
  status           String          @default("new") // new | read | archived
  whatsappOpened   Boolean         @default(false)
  privacyAccepted  Boolean         @default(false)
  privacyAcceptedAt DateTime?
  ipAddress        String?
  userAgent        String?         @db.Text
  createdAt        DateTime        @default(now())
  readAt           DateTime?

  @@index([status, createdAt])
  @@index([specializationId])
}

// Rate limiting + brute-force lockout (shared store, serverless-safe).
// Generic counter keyed by identifier (e.g. "contact:<ip>", "login:<email>").
model RateLimit {
  key         String    @id
  count       Int       @default(0)
  expiresAt   DateTime // when the current window resets
  lockedUntil DateTime? // login lockout expiry (null for generic limits)
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}
